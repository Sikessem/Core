{
    "type": "library",
    "name": "sikessem/core",
    "description": "Objects with strict types to manage PHP variables and values.",
    "homepage": "https://packagist.com/packages/sikessem/core",
    "license": "MIT",
    "keywords": [
        "php",
        "sikessem",
        "core",
        "capsule",
        "object",
        "values",
        "value-object",
        "array-object",
        "encapsulation",
        "accessor",
        "mutator",
        "property",
        "getter",
        "setter",
        "method",
        "event",
        "di",
        "ioc",
        "dic",
        "container",
        "psr",
        "dependency-injection",
        "injector",
        "encapsulator",
        "psr11",
        "php"
    ],
    "authors": [
        {
            "name": "SIGUI Kessé Emmanuel",
            "email": "siguici@proton.me",
            "homepage": "https://siguici.deno.dev"
        }
    ],
    "support": {
        "source": "https://github.com/sikessem/core",
        "issues": "https://github.com/sikessem/core/issues",
        "chat": "https://github.com/orgs/sikessem/discussions"
    },
    "require": {
        "php": "^8.2||^8.3",
        "psr/container": "^2.0",
        "sikessem/debugger": "^0.0.0"
    },
    "require-dev": {
        "sikessem/php-devtools": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "Sikessem\\": "src/"
        },
        "files": [
            "src/sikessem.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sikessem\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --ansi --memory-limit=-1 --debug",
        "check": "pint --test -v",
        "debug": [
            "@check",
            "@analyse",
            "@inspect",
            "@review",
            "@test"
        ],
        "devtools:init": [
            "psalm --init",
            "rector init",
            "pest --init"
        ],
        "fix": [
            "@refactor",
            "@format",
            "@lint"
        ],
        "format": "psalter --issues=all",
        "inspect": "psalm --no-diff",
        "lint": "pint -v",
        "test": "pest --colors=always",
        "review": "rector --dry-run --debug",
        "refactor": "rector"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        }
    },
    "config": {
        "bin-dir": "vendor/bin",
    	"vendor-dir": "vendor",
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
